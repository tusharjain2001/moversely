# Copy to ai/.env and fill in. server_local.py reads it at start-up.
# On a real server, set these as environment variables instead.

# Where leads and chats are stored. Leave unset for a SQLite file (ai/data/survey.db).
# Real server: DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
#   (and pip install "psycopg[binary]")
# DATABASE_URL=

# Password for the website's /admin page (leads and chats).
ADMIN_PASSWORD=change-me

# Chat model ("Talk to AI"). Defaults: Ollama on this machine with Qwen3 1.7B.
# CHAT_AI_URL=http://localhost:11434/v1
# CHAT_AI_MODEL=survey-chat
# CHAT_AI_KEY=
# CHAT_AI_EXTRA={"reasoning_effort": "none"}

# Survey models for a small (4 GB) GPU.
SURVEY_DEPTH=Ruicheng/moge-2-vitb-normal
