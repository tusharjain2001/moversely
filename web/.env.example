# Leave unset for a local demo: the site forwards /ai/* to http://localhost:8000.
# On Vercel, set it to the AI server URL (e.g. the Modal URL).
# NEXT_PUBLIC_AI_API_URL=https://you--ai-room-survey-api.modal.run

# Google Maps key for the "Moving to" search box (Maps JavaScript API + Places API).
# Built into the page, so restrict it to the site's domains in Google Cloud.
# Without it the form shows a plain list of countries.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
