# Settings for the booking server: copied to /opt/survey/ai/.env by setup.sh.
# Fill in on the server only; never commit the filled-in file.
# One setting per line, no comments after a value.

# The site's address. Leave empty until the domain points at this server; the
# site then runs on http://<server IP> (no camera, as that needs https).
SITE_DOMAIN=

# Password for the /admin page.
ADMIN_PASSWORD=

# Leads in DynamoDB (table made by deploy/create-tables.sh); chats and survey
# results are not stored. The server's IAM role gives access, so no AWS keys here.
DATABASE_URL=dynamodb
AWS_REGION=ap-southeast-1

# Room videos are analysed on the Modal GPU worker. Token: Modal -> Settings ->
# API Tokens -> New token, in the workspace the worker is deployed to.
SURVEY_GPU=modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Prices for the country pages from the sales team's Google Sheets (GET /ai/prices). The key is the
# service account's JSON file, copied to the server only (chmod 600). PRICE_SHEETS: route=sheet id pairs.
# GOOGLE_SERVICE_ACCOUNT_FILE=/opt/survey/ai/google-key.json
# PRICE_SHEETS=india=<sheet id>

# Lead emails (Gmail / Google Workspace app password).
SMTP_USER=
SMTP_PASSWORD=
# LEAD_EMAIL_TO=

# "Talk to AI" uses Ollama on this server by default. To use OpenAI instead:
# CHAT_AI_URL=https://api.openai.com/v1
# CHAT_AI_MODEL=<model name>
# CHAT_AI_KEY=<OpenAI API key>
# CHAT_AI_EXTRA={}
# Or Claude on Amazon Bedrock (needs bedrock:InvokeModel on the EC2 role survey-server-role; no key here):
# CHAT_AI_PROVIDER=bedrock
# CHAT_AI_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# CHAT_AI_REGION=us-east-1
# Limits for paid models (defaults shown):
# CHAT_AI_MAX_TOKENS=250
# CHAT_AI_PER_CHAT=15
# CHAT_AI_DAILY_LIMIT=1000
