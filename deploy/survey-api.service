[Unit]
Description=Booking API (leads, chat, lead emails; room videos go to Modal)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/survey/ai
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/opt/survey/ai/.venv/bin/python server_local.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
