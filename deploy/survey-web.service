[Unit]
Description=Booking website (Next.js)
After=network-online.target survey-api.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/survey/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
